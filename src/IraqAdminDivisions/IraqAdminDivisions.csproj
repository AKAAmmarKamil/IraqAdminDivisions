<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>netstandard2.0;net8.0</TargetFrameworks>
    <RootNamespace>IraqAdminDivisions</RootNamespace>
    <PackageId>IraqAdminDivisions</PackageId>
    <Version>1.1.0</Version>
    <IsPackable>true</IsPackable>
    <Description>Iraq's governorates, districts and sub-districts in Arabic, English and Kurdish with stable OCHA P-codes, coordinates, tolerant search, hierarchy navigation and address formatting. Offline, no lookup tables.</Description>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <EnablePackageValidation>true</EnablePackageValidation>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="../../data/divisions.json" Link="Data/divisions.json" LogicalName="IraqAdminDivisions.divisions.json" />
  </ItemGroup>

  <ItemGroup>
    <None Include="../../README.md" Pack="true" PackagePath="/" />
  </ItemGroup>

  <PropertyGroup Condition="'$(TargetFramework)' == 'net8.0'">
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="IraqAdminDivisions.Tests" />
    <InternalsVisibleTo Include="IraqAdminDivisions.Benchmarks" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.0'">
    <PackageReference Include="System.Text.Json" Version="8.0.5" />
    <PackageReference Include="System.ComponentModel.Annotations" Version="5.0.0" />
  </ItemGroup>

</Project>
